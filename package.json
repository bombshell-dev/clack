    "test": "pnpm --color -r run test",
    "pretest": "pnpm run build"
  },
  "devDependencies": {
    "@bomb.sh/tools": "^0.6.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.19.39",
    "jsr": "^0.13.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "node": "20.18.1"
  }
}
