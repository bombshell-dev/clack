{
  "name": "@clack/root",
  "type": "module",
  "private": true,
  "scripts": {
    "stub": "pnpm -r run build --stub",
    "build": "pnpm --filter \"@clack/*\" run build",
    "start": "pnpm run dev",
    "dev": "pnpm --filter @example/changesets run start",
    "format": "bsh format",
    "lint": "bsh lint",
    "types": "tsc --noEmit",
